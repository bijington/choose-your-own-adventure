<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>ChooseYourOwnAdventure</RootNamespace>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Choose Your Own Adventure</ApplicationTitle>

    <!--
      Work around a current .NET SDK Mac Catalyst `dotnet run` issue where
      the runner looks for the .app bundle by AssemblyName while the build
      can name it from ApplicationTitle. Keep them identical for Mac Catalyst.
      The user-facing name is retained via CFBundleDisplayName in Info.plist.
    -->
    <ApplicationTitle Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">ChooseYourOwnAdventure</ApplicationTitle>

    <!-- Make the local Mac Catalyst RID explicit for .NET 10. -->
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">maccatalyst-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">maccatalyst-x64</RuntimeIdentifier>
    <ApplicationId>com.tinysoft.colours</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <!-- Explicit with the custom non-UseMaui project setup: include the scene configuration. -->
    <PartialAppManifest Include="Platforms/MacCatalyst/Info.plist" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#111111" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#111111" BaseSize="128,128" />
    <EmbeddedResource Include="Resources/Images/Champions/*.png" LogicalName="ChooseYourOwnAdventure.Champions.%(Filename)%(Extension)" />
    <MauiFont Include="Resources/Fonts/CascadiaCode-VariableFont_wght.ttf" />
    <EmbeddedResource Include="../../TALK-GUIDE.md" LogicalName="ChooseYourOwnAdventure.TalkGuide.md" />
    <EmbeddedResource Include="Resources/Images/choose_your_own_adventure_title.png" LogicalName="ChooseYourOwnAdventure.TitleScreen.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bijington.Orbit.Engine" Version="0.2.2-preview.1" />
    <PackageReference Include="Bijington.Orbit.Input" Version="0.2.2-preview.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
