<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChooseYourOwnAdventure.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:engine="clr-namespace:Orbit.Engine;assembly=Orbit.Engine"
    BackgroundColor="#000000"
    Shell.NavBarIsVisible="False">

    <Grid>
        <engine:GameSceneView
            x:Name="GameView"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Loaded="OnGameViewLoaded">
            <engine:GameSceneView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGameViewTapped" />
            </engine:GameSceneView.GestureRecognizers>
        </engine:GameSceneView>
    </Grid>
</ContentPage>
